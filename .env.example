# Copy to .env and fill in. .env is gitignored.

# Twitch app credentials (https://dev.twitch.tv/console/apps -> Register / Manage app).
# Used for Helix API: user lookup, live status, stream metadata, viewer-made clips.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Telegram bot (create/rotate via @BotFather) and the chat that receives notifications.
# CHAT_ID is a numeric id or "@channelname".
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
